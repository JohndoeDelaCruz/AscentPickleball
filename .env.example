NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Public Turnstile sitekey. The supplied production key is also the app default.
# The private secret key is configured directly in Supabase Auth, never here.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAFnx7p5dsT8C-AVD
# Optional canonical website origin when deploying, e.g. https://ascent.example.com.
# Local callbacks use the browser's host and never the server's 0.0.0.0 bind address.
# NEXT_PUBLIC_SITE_URL=https://ascent.example.com
